# Backend environment (used for LOCAL development without Docker).
# In Docker, values come from the root .env via docker-compose.yml.
DATABASE_URL=postgresql://bloomnest:bloomnest@localhost:5432/bloomnest
PORT=4000
NODE_ENV=development
JWT_SECRET=dev_secret_change_me_in_production_0123456789abcdef
ORDER_PAYMENT_TTL_MINUTES=30
UPLOAD_DIR=./uploads
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
