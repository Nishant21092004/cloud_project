# ── BloomNest environment ─────────────────────────────────────────────
# Copy this file to `.env` and edit the values.
#   Windows PowerShell :  Copy-Item .env.example .env
#   Linux/macOS        :  cp .env.example .env
#
# NEVER commit your real .env file. It is ignored by .gitignore.

# ── PostgreSQL (used by the `db` container) ───────────────────────────
POSTGRES_USER=bloomnest
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=bloomnest

# Connection string used INSIDE the Docker network (host = `db`).
# Do not change the host unless you know what you are doing.
DATABASE_URL=postgresql://bloomnest:change_me_local@db:5432/bloomnest

# ── Backend ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# Secret used to sign login sessions (JWT). Generate a long random value:
#   PowerShell:  -join ((48..57)+(97..122) | Get-Random -Count 48 | % {[char]$_})
#   Linux     :  openssl rand -hex 32
JWT_SECRET=please_change_this_to_a_long_random_string_min_32_chars

# Minutes an online (Razorpay) payment may stay pending before the order
# expires and reserved stock is released.
ORDER_PAYMENT_TTL_MINUTES=30

# ── Razorpay (OPTIONAL — Cash on Delivery works without it) ──────────
# Create a free test account at https://dashboard.razorpay.com →
# Settings → API Keys → "Test Mode" keys.
# Leave empty to disable online payments (the site still works with COD).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Web ───────────────────────────────────────────────────────────────
# Host port for the Nginx container. Use 8080 if 80 is already in use.
WEB_PORT=80
